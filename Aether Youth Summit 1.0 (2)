@charset "utf-8";

:root { --color-primary: #d4af37; --color-primary-hover: #e5c158; --color-text: #ffffff; --color-text-secondary: #e8d5b7; --color-bg: #0a0e27; --duration-normal: 0.3s; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { font-family: "Space Grotesk", sans-serif; background: var(--color-bg); color: var(--color-text); line-height: 1.6; }

.hero { height: 100vh; background: linear-gradient(135deg, rgba(10, 14, 39, 0.4) 0%, rgba(42, 18, 61, 0.6) 100%) fixed, url("1000011507.jpg") center center / cover; display: flex; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.7)); z-index: 1; }

.hero-content { position: relative; z-index: 2; animation: 1s ease-out 0s 1 normal none running fadeInUp; }

.hero h1 { font-family: "EB Garamond", serif; font-size: 4.5rem; font-weight: 600; margin-bottom: 1rem; background: linear-gradient(135deg, rgb(255, 255, 255) 0%, rgb(212, 175, 55) 50%, rgb(45, 143, 185) 100%) text; -webkit-text-fill-color: transparent; text-shadow: rgba(212, 175, 55, 0.3) 0px 4px 20px; letter-spacing: 2px; }

.hero p { font-size: 1.3rem; margin-bottom: 2rem; color: rgb(232, 213, 183); letter-spacing: 1px; }

.btn { display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, rgb(212, 175, 55) 0%, rgb(229, 193, 88) 100%); color: rgb(10, 14, 39); text-decoration: none; border-radius: 50px; font-weight: 600; transition: all var(--duration-normal) ease; cursor: pointer; border: 2px solid rgb(212, 175, 55); margin: 0.5rem; font-size: 1rem; }

.btn:hover { transform: translateY(-3px); box-shadow: rgba(212, 175, 55, 0.4) 0px 10px 30px; }

.image-section { height: 100vh; background-size: cover; background-position: center center; background-attachment: fixed; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }

.image-section::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(135deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.7) 100%); z-index: 1; }

.section-content { position: relative; z-index: 2; text-align: center; max-width: 800px; padding: 2rem; animation: 1s ease-out 0s 1 normal none running fadeInUp; }

.section-content h2 { font-family: "EB Garamond", serif; font-size: 3.5rem; margin-bottom: 1.5rem; background: linear-gradient(135deg, rgb(212, 175, 55) 0%, rgb(255, 255, 255) 100%) text; -webkit-text-fill-color: transparent; letter-spacing: 2px; }

.section-content p { font-size: 1.2rem; color: rgb(232, 213, 183); margin: 0.8rem 0px; }

.section-1 { background-image: url("1000011499.jpg"); }

.section-2 { background-image: url("1000011504.jpg"); }

.section-3 { background-image: url("1000011503.jpg"); }

.section-4 { background-image: url("1000011497.jpg"); }

.benefits-section { padding: 6rem 2rem; background: linear-gradient(135deg, rgb(10, 14, 39) 0%, rgb(26, 31, 58) 100%); }

.benefits-section h2 { font-family: "EB Garamond", serif; font-size: 3.5rem; text-align: center; margin-bottom: 4rem; background: linear-gradient(135deg, rgb(212, 175, 55) 0%, rgb(255, 255, 255) 100%) text; -webkit-text-fill-color: transparent; }

.benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; max-width: 1400px; margin: 0px auto; }

.benefit-card { position: relative; height: 450px; border-radius: 15px; overflow: hidden; border: 2px solid rgba(212, 175, 55, 0.3); transition: 0.3s; }

.benefit-card:hover { transform: translateY(-10px); border-color: rgb(212, 175, 55); box-shadow: rgba(212, 175, 55, 0.2) 0px 20px 40px; }

.benefit-image { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0px; left: 0px; }

.benefit-overlay { position: absolute; inset: 0px; background: linear-gradient(rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.9) 100%); display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; z-index: 2; }

.benefit-name { font-family: "EB Garamond", serif; font-size: 1.8rem; margin-bottom: 0.5rem; color: var(--color-primary); }

.benefit-description { font-size: 1rem; color: rgb(232, 213, 183); opacity: 0.9; }

.contact-section { padding: 6rem 2rem; text-align: center; background: rgb(10, 14, 39); }

.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; max-width: 1200px; margin: 4rem auto; }

.contact-card { background: rgba(212, 175, 55, 0.1); border: 2px solid rgba(212, 175, 55, 0.3); border-radius: 15px; padding: 2.5rem; }

.contact-card h3 { font-family: "EB Garamond", serif; font-size: 1.8rem; color: var(--color-primary); }

.contact-phone { font-weight: 600; color: rgb(212, 175, 55); margin-top: 1rem; font-size: 1.2rem; }

.instagram-section { padding: 4rem 2rem; text-align: center; background: linear-gradient(rgba(212, 175, 55, 0.1), rgba(45, 143, 185, 0.1)); }

@keyframes fadeInUp { 
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (max-width: 768px) {
  .hero h1 { font-size: 2.5rem; }
  .section-content h2 { font-size: 2rem; }
}
